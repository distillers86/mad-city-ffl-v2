{
  "name": "mad-city-ffl",
  "version": "1.0.0",
  "description": "Payout tracker for the Mad City fantasy football league, built on the Sleeper API.",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production --base-href ./",
    "deploy": "npm run build:prod && npx gh-pages -d dist/mad-city-ffl/browser"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "gh-pages": "^6.0.0",
    "typescript": "~6.0.2"
  }
}
